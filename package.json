{
  "name": "hexwebmap",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "Static OpenStreetMap-style worldwide map for GitHub Pages",
  "homepage": "https://andyccr.github.io/Hexwebmap/",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hexwebmap/web",
    "build": "npm run build -w @hexwebmap/web",
    "preview": "npm run preview -w @hexwebmap/web",
    "test": "npm run test -w @hexwebmap/shared",
    "typecheck": "npm run typecheck -w @hexwebmap/shared && npm run typecheck -w @hexwebmap/web"
  },
  "engines": {
    "node": ">=22"
  }
}
